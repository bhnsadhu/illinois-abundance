# Public location and identity. No secrets belong in source control.
# Exact origin for this environment. Use HTTPS in production; rebuild after changing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Pooled Neon owner connection for server queries. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# Direct connection (no -pooler hostname), required by migrate and seed scripts.
DATABASE_URL_UNPOOLED=
# Must belong to a PRIVATE Vercel Blob store, including for preview environments.
BLOB_READ_WRITE_TOKEN=
# Sending-access key restricted to the verified MAIL_FROM domain.
RESEND_API_KEY=
MAIL_FROM=Illinois Abundance <abundance@bhanusadhu.com>
# Public removal/contact mailbox and up to two exact admin identities.
CONTACT_EMAIL=bhnsadhu@gmail.com
ADMIN_EMAIL=bhnsadhu@gmail.com
# Optional second admin. Create their reviewer account before configuring this.
SECOND_ADMIN_EMAIL=
# Separate random secrets, each at least 32 characters. Keep stable across deploys.
# Rotating CODE_PEPPER invalidates codes, login links, sessions, and digest previews.
CODE_PEPPER=
VIEW_SALT=
# Sample writing is visibly marked. Set false before launch.
SEED_SAMPLE_CONTENT=true
